{
  "openapi": "3.0.3",
  "info": {
    "title": "User Profile Service Contract",
    "version": "1.0.0",
    "description": "User Profile Microservice Contract - In-memory profile resolution, roles, and tier metadata"
  },
  "paths": {
    "/api/v1/users/me": {
      "get": {
        "summary": "Retrieve Authenticated User Profile",
        "operationId": "getProfileMe",
        "responses": {
          "200": {
            "description": "Current user profile record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{id}": {
      "get": {
        "summary": "Retrieve User Profile by ID",
        "operationId": "getUserById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User profile found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "summary": "List User Profiles (Paginated)",
        "operationId": "listUsers",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of user profiles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserListResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserProfile": {
        "type": "object",
        "required": [
          "user_id",
          "email",
          "full_name",
          "role",
          "status",
          "tier",
          "created_at"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "description": "Canonical user ID (e.g. usr_1001)"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Unique corporate or user email address"
          },
          "full_name": {
            "type": "string",
            "minLength": 2,
            "description": "Full display name"
          },
          "role": {
            "type": "string",
            "enum": ["admin", "engineer", "auditor", "viewer"],
            "description": "System authorization role"
          },
          "status": {
            "type": "string",
            "enum": ["active", "suspended", "provisioning"],
            "description": "Account status flag"
          },
          "tier": {
            "type": "string",
            "enum": ["enterprise", "pro", "standard"],
            "description": "Tenant subscription tier"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 creation timestamp"
          },
          "preferences": {
            "type": "object",
            "properties": {
              "theme": {
                "type": "string",
                "enum": ["dark", "light", "system"]
              },
              "notifications_enabled": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "UserListResponse": {
        "type": "object",
        "required": ["items", "total", "page", "limit"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserProfile"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error", "message"],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "status_code": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
