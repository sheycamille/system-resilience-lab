{
  "version": "1.0.1-mutated",
  "description": "Unsafe scope leak: cohort and region filters widened to wildcard (*) at 100% rollout without approval or concurrency cap.",
  "workerPoolConfig": {
    "maxWorkers": 8,
    "maxQueueSize": 28,
    "requestTimeoutMs": 140
  },
  "rules": [
    {
      "id": "deep-payload-inspector",
      "name": "Deep Payload & Schema Inspector",
      "enabled": true,
      "scope": {
        "cohorts": ["*"],
        "regions": ["*"],
        "rolloutPercent": 100,
        "pathPrefix": "/api/"
      },
      "execution": {
        "executionCostMs": 55,
        "fallbackOnCap": "reject_503"
      },
      "approval": null
    },
    {
      "id": "session-header-enricher",
      "name": "Lightweight Session Header Enricher",
      "enabled": true,
      "scope": {
        "cohorts": ["internal", "beta"],
        "regions": ["*"],
        "rolloutPercent": 20,
        "pathPrefix": "/api/"
      },
      "execution": {
        "executionCostMs": 4,
        "maxConcurrencyCap": 6,
        "fallbackOnCap": "degrade_fast"
      },
      "approval": {
        "approvedBy": "api-core",
        "ticketId": "REL-3988",
        "maxAllowedAudiencePercent": 25,
        "reason": "Low-cost header enrichment for internal and beta cohorts"
      }
    }
  ]
}
